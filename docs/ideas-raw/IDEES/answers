(defun create-omega-evaluator-v13-theta (&key force-regenerate-keys)
  "Create Level 13 Theta metacognitive evaluator.
   
   Key Generation Strategy:
     1. Check if keys exist in ~/.omega-keys/
     2. If exist AND valid → Load them
     3. If not exist OR invalid OR force-regenerate → Generate new
     4. Save to filesystem with secure permissions
     5. Store in evaluator slots
   
   Returns: Initialized evaluator with keys"
  
  (let ((evaluator (make-instance 'omega-evaluator-v13-theta)))
    
    ;; Key management
    (if (and (not force-regenerate-keys)
             (keys-exist-p)
             (keys-valid-p))
        
        ;; Load existing keys
        (progn
          (setf (evaluator-private-key evaluator)
                (load-key-from-filesystem evaluator :private))
          (setf (evaluator-public-key evaluator)
                (load-key-from-filesystem evaluator :public))
          (log-info "Loaded existing Ed25519 keys"))
        
        ;; Generate new keys
        (multiple-value-bind (private-key public-key)
            (generate-ed25519-keypair)
          
          (setf (evaluator-private-key evaluator) private-key)
          (setf (evaluator-public-key evaluator) public-key)
          
          ;; Save to filesystem
          (save-keys-to-disk evaluator)
          
          (log-info "Generated new Ed25519 keys")))
    
    ;; Initialize other components
    (initialize-evaluator-components evaluator)
    
    evaluator))

(defun generate-ed25519-keypair ()
  "Generate new Ed25519 keypair using Ironclad.
   
   Algorithm: Ed25519 (RFC 8032)
   Library: Ironclad
   
   Returns: (values private-key public-key)"
  
  (let* ((prng (ironclad:make-prng :fortuna :seed :random))
         (keypair (ironclad:generate-key-pair :ed25519 :prng prng)))
    
    (values
     (ironclad:ed25519-key-y (getf keypair :private-key))
     (ironclad:ed25519-key-y (getf keypair :public-key)))))

(defun save-keys-to-disk (evaluator)
  "Save keys to filesystem with secure permissions.
   
   Steps:
     1. Create ~/.omega-keys/ if not exist (700 permissions)
     2. Write private key (600 permissions)
     3. Write public key (644 permissions)
     4. Create backup with timestamp
     5. Write fingerprint file
   
   Returns: T on success"
  
  (let ((key-dir (key-storage-path)))
    
    ;; Create directory with secure permissions
    (ensure-directories-exist key-dir)
    (set-file-permissions key-dir #o700)
    
    ;; Write private key
    (let ((private-file (merge-pathnames "private.key" key-dir)))
      (with-open-file (stream private-file
                              :direction :output
                              :if-exists :supersede
                              :element-type '(unsigned-byte 8))
        (write-sequence (evaluator-private-key evaluator) stream))
      (set-file-permissions private-file #o600))
    
    ;; Write public key
    (let ((public-file (merge-pathnames "public.key" key-dir)))
      (with-open-file (stream public-file
                              :direction :output
                              :if-exists :supersede
                              :element-type '(unsigned-byte 8))
        (write-sequence (evaluator-public-key evaluator) stream))
      (set-file-permissions public-file #o644))
    
    ;; Create backup
    (backup-keys key-dir)
    
    ;; Write fingerprint
    (save-key-fingerprint key-dir evaluator)
    
    t))
