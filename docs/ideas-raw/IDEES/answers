```lisp
(defmacro with-infinite-recursion-protection ((evaluator) &body body)
  "Protect against infinite recursion in evaluation.
   
   Strategy:
     1. Maintain seen-states hash table (memoization)
     2. Depth counter with cutoff
     3. Lazy thunk creation for delayed evaluation
   
   If recursion detected:
     - Return :infinite-recursion marker
     - Log recursion trace
     - Don't crash"
  
  `(let* ((*recursion-depth* 0)
          (*seen-states* (make-hash-table :test #'equalp))
          (*recursion-trace* '()))
     
     (labels ((protected-eval (expr)
                (progn
                  ;; Increment depth
                  (incf *recursion-depth*)
                  
                  ;; Check depth limit
                  (when (> *recursion-depth* *max-recursion-depth*)
                    (return-from protected-eval
                      (make-recursion-error
                       :reason :max-depth-exceeded
                       :depth *recursion-depth*
                       :trace *recursion-trace*)))
                  
                  ;; Check if seen before (cycle detection)
                  (let ((state-key (compute-state-key ,evaluator expr)))
                    (when (gethash state-key *seen-states*)
                      (return-from protected-eval
                        (make-recursion-error
                         :reason :cycle-detected
                         :depth *recursion-depth*
                         :cycle-point state-key
                         :trace *recursion-trace*)))
                    
                    ;; Mark as seen
                    (setf (gethash state-key *seen-states*) t)
                    (push expr *recursion-trace*))
                  
                  ;; Evaluate
                  (unwind-protect
                      (progn ,@body)
                    (decf *recursion-depth*)))))
       
       (protected-eval (quote body)))))

(defparameter *max-recursion-depth* 1000
  "Maximum recursion depth before protection kicks in")

(defun compute-state-key (evaluator expression)
  "Compute unique key for (evaluator, expression) state.
   
   Key components:
     - Expression AST hash
     - Environment fingerprint
     - Stack depth
   
   Returns: Comparable key for hash table"
  
  (list (sxhash expression)
        (environment-fingerprint (evaluator-environment evaluator))
        (evaluator-stack-depth evaluator)))
