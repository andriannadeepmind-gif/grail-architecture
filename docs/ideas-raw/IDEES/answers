(defun sign-evaluator-state (evaluator)
  "Sign evaluator state using Ed25519.
   
   Algorithm: Ed25519 (CONFIRMED)
   Library: Ironclad
   
   Steps:
     1. Compute state fingerprint (SHA3-512)
     2. Sign fingerprint with private key
     3. Store signature in evaluator
   
   Returns: Signature bytes"
  
  (let* ((state-fingerprint (compute-state-fingerprint evaluator))
         (private-key (evaluator-private-key evaluator))
         (signature (ironclad:sign-message 
                     private-key
                     state-fingerprint
                     :ed25519)))
    
    (setf (evaluator-signature evaluator) signature)
    signature))

(defun verify-evaluator-signature (evaluator)
  "Verify evaluator state signature.
   
   Steps:
     1. Recompute state fingerprint
     2. Get stored signature
     3. Verify with public key
   
   Returns: T if valid, NIL if tampered"
  
  (let ((state-fingerprint (compute-state-fingerprint evaluator))
        (stored-signature (evaluator-signature evaluator))
        (public-key (evaluator-public-key evaluator)))
    
    (ironclad:verify-signature 
     public-key
     state-fingerprint
     stored-signature
     :ed25519)))

(defun compute-state-fingerprint (evaluator)
  "Compute SHA3-512 fingerprint of evaluator state.
   
   Includes:
     - Stack contents
     - Environment bindings
     - Logical time
     - Causal chain
     - Configuration
   
   Returns: 64-byte SHA3-512 hash"
  
  (let ((digest (ironclad:make-digest :sha3/512)))
    
    ;; Add stack
    (ironclad:update-digest digest 
      (serialize-stack (evaluator-stack evaluator)))
    
    ;; Add environment
    (ironclad:update-digest digest
      (serialize-environment (evaluator-environment evaluator)))
    
    ;; Add logical time
    (ironclad:update-digest digest
      (integer-to-octets (evaluator-logical-time evaluator)))
    
    ;; Add causal chain
    (ironclad:update-digest digest
      (serialize-causal-chain (evaluator-causal-chain evaluator)))
    
    ;; Produce final hash
    (ironclad:produce-digest digest)))
