  "Repair type violations by coercing to correct types."
  (walk-evaluator-state 
   evaluator
   (lambda (slot value)
     (let ((expected-type (slot-expected-type slot)))
       (unless (typep value expected-type)
         (setf (slot-value evaluator slot)
               (coerce-to-type value expected-type)))))))

