(defun sandboxed-module (module)
  "Wrap module in sandbox for isolation.
   
   Returns: Sandboxed wrapper that:
     1. Runs module in separate process (fork)
     2. Limits memory/CPU usage
     3. Restricts syscalls (seccomp)
     4. Isolates filesystem (chroot)
     5. IPC via pipes
   
   Implementation:
     - Unix: fork + seccomp + chroot
     - Non-Unix: Thread with limited capabilities"
  
  (let ((sandbox (make-instance 'sandbox
                                :memory-limit (* 100 1024 1024)
                                :cpu-limit 60
                                :network-access nil
                                :filesystem-access :read-only)))
    
    #+unix
    (sandbox-unix module sandbox)
    
    #-unix
    (sandbox-thread module sandbox)))

(defun sandbox-unix (module sandbox)
  "Sandbox module using Unix process isolation.
   
   Steps:
     1. Fork new process
     2. In child: Drop privileges
     3. In child: Set resource limits (setrlimit)
     4. In child: Install seccomp filter
     5. In child: Chroot to sandbox directory
     6. In child: Run module
     7. In parent: Monitor via pipes"
  
  (let ((pid (unix-fork)))
    (cond
      ((zerop pid)
       ;; Child process
       (setup-resource-limits sandbox)
       (install-seccomp-filter sandbox)
       (chroot-sandbox)
       (run-module-in-sandbox module)
       (unix-exit 0))
      
      (t
       ;; Parent process
       (setf (sandbox-process-id sandbox) pid)
       (monitor-sandboxed-module pid module)))))

(defun setup-resource-limits (sandbox)
  "Set RLIMIT for memory and CPU."
  (unix-setrlimit :rlimit-as (sandbox-memory-limit sandbox))
  (unix-setrlimit :rlimit-cpu (sandbox-cpu-limit sandbox)))

(defun install-seccomp-filter (sandbox)
  "Install seccomp-bpf filter to whitelist syscalls."
  (let ((allowed (sandbox-allowed-syscalls sandbox)))
    (seccomp-install-filter
     :whitelist allowed
     :default-action :kill)))
