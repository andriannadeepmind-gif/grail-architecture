(defun meta-eval (evaluator expression &optional environment)
  "Metacircular evaluator with self-evaluation support.
   
   Special case: (meta-eval evaluator evaluator)
   
   Termination Strategy:
     1. Logical time counter (incremented each evaluation)
     2. Fixed point detection (same state as before)
     3. Max recursion depth (1000 levels)
     4. Similarity threshold (95% similar → terminate)
   
   Returns: Evaluated value OR fixed-point marker"
  
  ;; Check for self-evaluation
  (when (and (symbolp expression)
             (eq (symbol-value expression) evaluator))
    (return-from meta-eval
      (handle-self-evaluation evaluator environment)))
  
  ;; Normal evaluation path...
  (dispatch-evaluation evaluator expression environment))

(defun handle-self-evaluation (evaluator environment)
  "Handle (evaluate evaluator evaluator) with guaranteed termination.
   
   Algorithm:
     1. Increment logical time
     2. Check if reached fixed point
     3. If not, compute one more level
     4. Check similarity to previous level
     5. If >95% similar, return fixed point
     6. If depth > 1000, return approximate fixed point
   
   Returns: Fixed point or meta-level representation"
  
  (let ((logical-time (evaluator-logical-time evaluator))
        (recursion-depth (evaluator-self-eval-depth evaluator))
        (previous-state (evaluator-previous-state evaluator)))
    
    ;; TERMINATION CHECK 1: Max recursion depth
    (when (>= recursion-depth *max-self-eval-depth*)
      (return-from handle-self-evaluation
        (make-fixed-point
         :reason :max-depth-reached
         :depth recursion-depth
         :approximation evaluator)))
    
    ;; TERMINATION CHECK 2: Fixed point detection
    (when (and previous-state
               (evaluator-equal-p evaluator previous-state))
      (return-from handle-self-evaluation
        (make-fixed-point
         :reason :exact-fixed-point
         :depth recursion-depth
         :value evaluator)))
    
    ;; TERMINATION CHECK 3: Similarity threshold
    (when (and previous-state
               (> (evaluator-similarity evaluator previous-state) 0.95))
      (return-from handle-self-evaluation
        (make-fixed-point
         :reason :approximate-fixed-point
         :depth recursion-depth
         :similarity (evaluator-similarity evaluator previous-state)
         :value evaluator)))
    
    ;; TERMINATION CHECK 4: Logical time limit
    (when (> logical-time *max-logical-time*)
      (return-from handle-self-evaluation
        (make-fixed-point
         :reason :timeout
         :depth recursion-depth
         :value evaluator)))
    
    ;; If not terminating, do one more level
    (let ((next-level-evaluator (copy-evaluator evaluator)))
      
      ;; Increment counters
      (incf (evaluator-logical-time next-level-evaluator))
      (incf (evaluator-self-eval-depth next-level-evaluator))
      
      ;; Save current state
      (setf (evaluator-previous-state next-level-evaluator) 
            (copy-evaluator evaluator))
      
      ;; Evaluate one more level
      (meta-eval next-level-evaluator 'self environment))))

(defparameter *max-self-eval-depth* 1000
  "Maximum recursion depth for self-evaluation")

(defparameter *max-logical-time* 1000000
  "Maximum logical time before timeout")

(defun evaluator-equal-p (ev1 ev2)
  "Check if two evaluators are in identical state.
   
   Compares:
     - State fingerprint
     - Stack depth
     - Environment bindings
     - Logical time
   
   Returns: T if identical, NIL otherwise"
  
  (and (equalp (evaluator-state-fingerprint ev1)
               (evaluator-state-fingerprint ev2))
       (= (evaluator-stack-depth ev1)
          (evaluator-stack-depth ev2))
       (= (evaluator-logical-time ev1)
          (evaluator-logical-time ev2))))

(defun evaluator-similarity (ev1 ev2)
  "Compute similarity between two evaluators (0.0-1.0).
   
   Weighted factors:
     - Fingerprint similarity: 40%
     - Stack similarity: 20%
     - Environment similarity: 30%
     - Logical time similarity: 10%
   
   Returns: Similarity score 0.0-1.0"
  
  (let ((fingerprint-sim (fingerprint-similarity 
                          (evaluator-state-fingerprint ev1)
                          (evaluator-state-fingerprint ev2)))
        (stack-sim (/ (min (evaluator-stack-depth ev1)
                          (evaluator-stack-depth ev2))
                     (max (evaluator-stack-depth ev1)
                          (evaluator-stack-depth ev2))))
        (env-sim (environment-similarity 
                  (evaluator-environment ev1)
                  (evaluator-environment ev2)))
        (time-sim (/ (min (evaluator-logical-time ev1)
                         (evaluator-logical-time ev2))
                    (max (evaluator-logical-time ev1)
                         (evaluator-logical-time ev2)))))
    
    (+ (* 0.4 fingerprint-sim)
       (* 0.2 stack-sim)
       (* 0.3 env-sim)
       (* 0.1 time-sim))))
