(defun detect-state-corruption (evaluator)
  "Detect corruption in evaluator state.
   
   Checks (in order):
     1. Fingerprint validity (SHA3-512)
     2. Stack depth reasonableness
     3. Circular causality detection
     4. Hook integrity verification
     5. Memory consistency
     6. Port registry sanity
     7. Temporal ordering
   
   Returns: List of VIOLATION structures or NIL"
  
  (let ((violations '()))
    
    ;; CHECK 1: Fingerprint
    (unless (fingerprint-valid-p evaluator)
      (push (make-violation
             :type :fingerprint-mismatch
             :severity :critical
             :detected-at (get-logical-time)
             :details "SHA3-512 hash mismatch - state may be tampered")
            violations))
    
    ;; CHECK 2: Stack depth
    (unless (stack-depth-reasonable-p evaluator)
      (push (make-violation
             :type :stack-overflow-risk
             :severity :high
             :detected-at (get-logical-time)
             :details (format nil "Stack depth ~A exceeds maximum ~A"
                             (evaluator-stack-depth evaluator)
                             *max-stack-depth*))
            violations))
    
    ;; CHECK 3: Circular causality
    (let ((circular-deps (detect-circular-causality evaluator)))
      (when circular-deps
        (push (make-violation
               :type :circular-causality
               :severity :high
               :detected-at (get-logical-time)
               :details (format nil "Circular dependency: ~A" circular-deps))
              violations)))
    
    ;; CHECK 4: Hooks intact
    (unless (hooks-intact-p evaluator)
      (push (make-violation
             :type :hooks-corrupted
             :severity :medium
             :detected-at (get-logical-time)
             :details "Reflection hooks or external modules corrupted")
            violations))
    
    ;; CHECK 5: Memory consistency
    (unless (memory-consistent-p evaluator)
      (push (make-violation
             :type :memory-corruption
             :severity :critical
             :detected-at (get-logical-time)
             :details "Internal data structures corrupted")
            violations))
    
    ;; CHECK 6: Port registry
    (unless (port-registry-sane-p evaluator)
      (push (make-violation
             :type :port-registry-corruption
             :severity :medium
             :detected-at (get-logical-time)
             :details "Port registry contains invalid entries")
            violations))
    
    ;; CHECK 7: Temporal ordering
    (unless (temporal-ordering-valid-p evaluator)
      (push (make-violation
             :type :temporal-paradox
             :severity :high
             :detected-at (get-logical-time)
             :details "Logical time ordering violated")
            violations))
    
    violations))

(defun fingerprint-valid-p (evaluator)
  "Check if SHA3-512 fingerprint matches current state.
   
   Algorithm:
     1. Extract stored fingerprint
     2. Recompute fingerprint from current state
     3. Compare using constant-time comparison (timing attack resistant)
   
   Returns: T if valid, NIL if corrupted"
  
  (let ((stored-fingerprint (evaluator-state-fingerprint evaluator))
        (computed-fingerprint (compute-state-fingerprint evaluator)))
    
    ;; Use constant-time comparison to prevent timing attacks
    (constant-time-equal stored-fingerprint computed-fingerprint)))

(defun stack-depth-reasonable-p (evaluator)
  "Check if stack depth is within reasonable bounds.
   
   Max Depth: 1000 (configurable via *max-stack-depth*)
   
   Rationale:
     - Normal evaluation: 10-100 levels
     - Recursive functions: 100-500 levels
     - Metacircular: 500-1000 levels
     - >1000: Likely infinite recursion"
  
  (<= (evaluator-stack-depth evaluator) *max-stack-depth*))

(defparameter *max-stack-depth* 1000
  "Maximum allowed stack depth before triggering violation")

(defun detect-circular-causality (evaluator)
  "Detect circular dependencies in causal chain.
   
   Algorithm:
     1. Extract causal chain from evaluator
     2. Build dependency graph
     3. Run cycle detection (Tarjan's algorithm)
     4. Return cycles if found
   
   Returns: List of cycles or NIL"
  
  (let ((causal-chain (evaluator-causal-chain evaluator))
        (dependency-graph (build-dependency-graph causal-chain)))
    
    ;; Tarjan's strongly connected components
    (find-cycles-tarjan dependency-graph)))

(defun hooks-intact-p (evaluator)
  "Check if reflection hooks and external modules are intact.
   
   Checks:
     1. Reflection hooks are functions (not corrupted pointers)
     2. External modules respond to ping
     3. Module interfaces match expected protocol
     4. No unauthorized modules attached
   
   Returns: T if intact, NIL if corrupted"
  
  (and
   ;; Reflection hooks are valid functions
   (every #'functionp (evaluator-reflection-hooks evaluator))
   
   ;; External modules respond
   (every #'module-alive-p (evaluator-external-modules evaluator))
   
   ;; Module interfaces valid
   (every #'valid-module-interface-p (evaluator-external-modules evaluator))
   
   ;; No unauthorized modules
   (every #'module-authorized-p (evaluator-external-modules evaluator))))
