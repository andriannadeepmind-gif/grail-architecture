(defun repair-violations (evaluator violations)
  "Repair detected violations using appropriate strategies.
   
   Algorithm:
     1. Sort violations by severity (critical first)
     2. For each violation:
        a. Look up repair action
        b. Execute repair function
        c. Re-check invariant
        d. Log repair attempt
     3. If repair fails, escalate
     4. Return repair summary
   
   Returns: REPAIR-SUMMARY structure"
  
  (let ((repair-summary (make-repair-summary))
        (sorted-violations (sort (copy-list violations) #'> 
                                :key #'violation-severity-rank)))
    
    (dolist (violation sorted-violations)
      (let ((repair-action (violation-repair-action violation))
            (repair-success nil))
        
        ;; Execute repair
        (handler-case
            (progn
              (funcall (repair-function-for-action repair-action)
                       evaluator
                       violation)
              
              ;; Re-check invariant
              (if (funcall (violation-check-function violation) evaluator)
                  (progn
                    (setf repair-success t)
                    (log-repair-success violation))
                  (progn
                    (setf repair-success nil)
                    (log-repair-failure violation))))
          
          (error (e)
            (setf repair-success nil)
            (log-repair-error violation e)))
        
        ;; Record in summary
        (push (make-repair-record
               :violation violation
               :action repair-action
               :success repair-success
               :timestamp (get-logical-time))
              (repair-summary-records repair-summary))
        
        ;; Escalate if critical repair failed
        (when (and (not repair-success)
                   (eq (violation-severity violation) :critical))
          (escalate-to-human-operator evaluator violation))))
    
    repair-summary))

(defun repair-function-for-action (action-keyword)
  "Map repair action keyword to repair function."
  (ecase action-keyword
    (:recompute-fingerprint #'repair-recompute-fingerprint)
    (:unwind-stack #'repair-unwind-stack)
    (:break-causal-cycle #'repair-break-causal-cycle)
    (:restore-hooks #'repair-restore-hooks)
    (:restore-from-checkpoint #'repair-restore-from-checkpoint)
    (:clean-port-registry #'repair-clean-port-registry)
    (:reset-logical-time #'repair-reset-logical-time)
    (:type-coercion #'repair-type-coercion)
    (:rebuild-environment #'repair-rebuild-environment)
    (:acquire-locks #'repair-acquire-locks)
    (:garbage-collect #'repair-garbage-collect)
    (:regenerate-keys #'repair-regenerate-keys)))

;;; SPECIFIC REPAIR FUNCTIONS

(defun repair-recompute-fingerprint (evaluator violation)
  "Repair fingerprint mismatch by recomputing from current state."
  (setf (evaluator-state-fingerprint evaluator)
        (compute-state-fingerprint evaluator)))

(defun repair-unwind-stack (evaluator violation)
  "Repair stack overflow by unwinding to safe depth."
  (let ((safe-depth (floor *max-stack-depth* 2)))
    (loop while (> (evaluator-stack-depth evaluator) safe-depth)
          do (pop-evaluation-frame evaluator))))

(defun repair-break-causal-cycle (evaluator violation)
  "Repair circular causality by breaking oldest dependency."
  (let ((cycles (detect-circular-causality evaluator)))
    (dolist (cycle cycles)
      ;; Break cycle at oldest edge
      (let ((oldest-edge (find-oldest-edge cycle)))
        (remove-causal-dependency evaluator oldest-edge)))))

(defun repair-restore-hooks (evaluator violation)
  "Repair corrupted hooks by restoring from backup."
  (let ((backup-hooks (evaluator-hook-backup evaluator)))
    (setf (evaluator-reflection-hooks evaluator) backup-hooks)
    ;; Re-ping external modules
    (mapc #'ping-module (evaluator-external-modules evaluator))))

(defun repair-restore-from-checkpoint (evaluator violation)
  "Repair memory corruption by restoring from last checkpoint."
  (let ((checkpoint (find-last-valid-checkpoint evaluator)))
    (if checkpoint
        (restore-evaluator-from-checkpoint evaluator checkpoint)
        (error "No valid checkpoint found - cannot repair"))))

(defun repair-clean-port-registry (evaluator violation)
  "Clean corrupted port registry entries."
  (let ((registry (evaluator-port-registry evaluator)))
    (maphash (lambda (key value)
               (unless (valid-port-entry-p value)
                 (remhash key registry)))
             registry)))

