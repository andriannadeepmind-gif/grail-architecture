(defun evaluator-private-key (evaluator)
  "Get private Ed25519 key for evaluator.
   
   Key Storage Strategy:
     - Primary: In-memory (evaluator-private-key slot)
     - Backup: Filesystem (~/.omega-keys/)
     - Fallback: Environment variable OMEGA_PRIVATE_KEY
     - Never: HSM (for this version - maybe v4.0)
   
   Returns: Ed25519 private key bytes"
  
  (or
   ;; Try in-memory first
   (slot-value evaluator 'private-key)
   
   ;; Try filesystem
   (load-key-from-filesystem evaluator :private)
   
   ;; Try environment
   (load-key-from-environment :private)
   
   ;; Generate new if none exist
   (generate-and-store-new-keys evaluator)))

(defun key-storage-path ()
  "Get path to key storage directory.
   
   Location: ~/.omega-keys/
   
   Directory structure:
     ~/.omega-keys/
       ├── private.key (600 permissions)
       ├── public.key (644 permissions)
       ├── backup/
       │   ├── private-2025-11-02.key
       │   └── public-2025-11-02.key
       └── .fingerprint (hash of keys)
   
   Returns: Pathname"
  
  (merge-pathnames ".omega-keys/" (user-homedir-pathname)))

(defun load-key-from-filesystem (evaluator key-type)
  "Load key from filesystem.
   
   Security:
     - Verify file permissions (600 for private, 644 for public)
     - Verify file owner (must be current user)
     - Verify fingerprint (prevent tampering)
     - Clear key from memory after use
   
   Returns: Key bytes or NIL if not found"
  
  (let* ((key-dir (key-storage-path))
         (key-file (merge-pathnames 
                    (ecase key-type
                      (:private "private.key")
                      (:public "public.key"))
                    key-dir)))
    
    (when (probe-file key-file)
      ;; Verify permissions
      (unless (correct-permissions-p key-file key-type)
        (error "Insecure key file permissions: ~A" key-file))
      
      ;; Verify owner
      (unless (correct-owner-p key-file)
        (error "Key file has wrong owner: ~A" key-file))
      
      ;; Read key
      (with-open-file (stream key-file
                              :direction :input
                              :element-type '(unsigned-byte 8))
        (let ((key (make-array (file-length stream)
                               :element-type '(unsigned-byte 8))))
          (read-sequence key stream)
          
          ;; Verify fingerprint
          (when (ecase key-type
                  (:private (verify-private-key-fingerprint key))
                  (:public (verify-public-key-fingerprint key)))
            key))))))

(defun correct-permissions-p (filepath key-type)
  "Check if file has correct Unix permissions.
   
   Private key: 600 (rw-------)
   Public key: 644 (rw-r--r--)"
  
  (let ((permissions (file-permissions filepath)))
    (ecase key-type
      (:private (= permissions #o600))
      (:public (= permissions #o644)))))
