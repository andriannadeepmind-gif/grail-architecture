(defstruct world
  "Possible world for modal/paraconsistent logic.
   
   Based on Kripke frames (W, R, V) where:
     W = set of possible worlds
     R = accessibility relation
     V = valuation function"
  
  (id (gensym "WORLD-"))
  (type :normal) ; :normal, :both-true, :both-false, :inconsistent
  (facts (make-hash-table :test #'equal)) ; Propositions → Truth values
  (accessibility-relations '()) ; List of accessible worlds
  (constraints '()) ; World-specific constraints
  (modal-operators '(:necessary :possible :contingent))
  (paraconsistent-p nil)) ; Allow contradictions?

(defun evaluate-in-world (evaluator expression world)
  "Evaluate expression in specific possible world.
   
   Algorithm:
     1. Save current world context
     2. Switch to target world
     3. Bind world-specific facts as environment
     4. Evaluate expression in world environment
     5. Restore original world
     6. Return value from target world
   
   Modal Logic:
     - □φ (necessary): φ is true in ALL accessible worlds
     - ◇φ (possible): φ is true in SOME accessible world
     
   Paraconsistent:
     - In :both-true world: (and A (not A)) → TRUE
     - In :both-false world: (or A (not A)) → FALSE"
  
  (let ((original-world (evaluator-current-world evaluator))
        (world-environment (world-to-environment world)))
    
    (unwind-protect
        (progn
          ;; Switch to target world
          (setf (evaluator-current-world evaluator) world)
          
          ;; Evaluate in world context
          (let ((*current-world* world)
                (*allow-contradictions* (world-paraconsistent-p world)))
            
            (case (world-type world)
              (:both-true
               ;; In this world, contradictions are true
               (if (contradiction-p expression)
                   t ; Return TRUE for contradictions
                   (meta-eval evaluator expression world-environment)))
              
              (:both-false
               ;; In this world, contradictions are false
               (if (contradiction-p expression)
                   nil ; Return FALSE for contradictions
                   (meta-eval evaluator expression world-environment)))
              
              (:normal
               ;; Standard evaluation
               (meta-eval evaluator expression world-environment))
              
              (:inconsistent
               ;; Explosion principle doesn't apply
               ;; Can derive anything but don't
               (paraconsistent-eval evaluator expression world-environment)))))
      
      ;; Restore original world
      (setf (evaluator-current-world evaluator) original-world))))

(defun create-world (&key (type :normal) facts paraconsistent-p)
  "Create a new possible world.
   
   World Types:
     :normal - Standard classical logic
     :both-true - Paraconsistent (A ∧ ¬A can be true)
     :both-false - Paraconsistent (A ∨ ¬A can be false)
     :inconsistent - Contains contradictions but doesn't explode"
  
  (let ((world (make-world :type type
                           :paraconsistent-p paraconsistent-p)))
    
    ;; Initialize facts
    (when facts
      (dolist (fact facts)
        (setf (gethash (first fact) (world-facts world))
              (second fact))))
    
    ;; Add default accessibility relations
    (case type
      (:both-true
       ;; Accessible from normal world
       (push :normal (world-accessibility-relations world)))
      (:both-false
       ;; Also accessible from normal
       (push :normal (world-accessibility-relations world))))
    
    world))
