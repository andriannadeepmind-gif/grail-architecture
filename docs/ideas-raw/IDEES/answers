(defun dialectical-synthesis (evaluator thesis antithesis)
  "Synthesize thesis and antithesis using Hegelian dialectic.
   
   Returns: SYNTHESIS-RESULT structure with:
     - :value - The synthesized value
     - :confidence - Confidence level (0.0-1.0)
     - :contradiction-detected-p - Boolean
     - :resolution-strategy - Keyword
     - :dialectical-trace - History of synthesis
   
   Algorithm:
     1. Evaluate thesis in current context
     2. Evaluate antithesis in current context
     3. Detect contradiction (thesis ≠ antithesis)
     4. If contradiction:
        a. Create both-true world (paraconsistent)
        b. Create both-false world
        c. Evaluate in both worlds
        d. Apply resolution strategy
     5. Return synthesis"
  
  (let ((thesis-value (meta-eval evaluator thesis))
        (antithesis-value (meta-eval evaluator antithesis)))
    
    (if (contradictory-p thesis-value antithesis-value)
        ;; PARACONSISTENT PATH
        (let* ((both-true-world (create-world :both-true))
               (both-false-world (create-world :both-false))
               (true-eval (evaluate-in-world evaluator thesis both-true-world))
               (false-eval (evaluate-in-world evaluator antithesis both-false-world))
               (synthesis (apply-resolution-strategy 
                           evaluator
                           :thesis thesis-value
                           :antithesis antithesis-value
                           :strategy :hegelian-aufhebung)))
          
          (make-synthesis-result
           :value synthesis
           :confidence 0.7 ; Lower confidence for contradictions
           :contradiction-detected-p t
           :resolution-strategy :hegelian-aufhebung
           :dialectical-trace (list thesis-value antithesis-value synthesis)))
        
        ;; NO CONTRADICTION - Simple composition
        (make-synthesis-result
         :value (compose-values thesis-value antithesis-value)
         :confidence 1.0
         :contradiction-detected-p nil
         :resolution-strategy :direct-composition
         :dialectical-trace (list thesis-value antithesis-value)))))

(defun apply-resolution-strategy (evaluator &key thesis antithesis strategy)
  "Apply resolution strategy to contradiction.
   
   Strategies:
     :hegelian-aufhebung - Preserve and transcend (Hegel's Aufhebung)
     :dominant-thesis - Thesis prevails
     :dominant-antithesis - Antithesis prevails
     :quantum-superposition - Keep both (quantum-like)
     :democratic - Majority vote from evidence
     :contextual - Depends on context"
  
  (ecase strategy
    (:hegelian-aufhebung
     ;; Aufhebung = preserve + negate + transcend
     ;; Synthesis INCLUDES both but at higher level
     (make-aufhebung
      :preserved-thesis thesis
      :preserved-antithesis antithesis
      :transcended-value (transcend-contradiction thesis antithesis)))
    
    (:dominant-thesis thesis)
    (:dominant-antithesis antithesis)
    
    (:quantum-superposition
     ;; Quantum-like superposition - both are true simultaneously
     (make-superposition
      :branches (list thesis antithesis)
      :collapse-function #'democratic-collapse))
    
    (:democratic
     ;; Vote based on evidence strength
     (if (> (evidence-strength thesis) (evidence-strength antithesis))
         thesis
         antithesis))
    
    (:contextual
     ;; Context-dependent resolution
     (resolve-by-context evaluator thesis antithesis))))
